# API Backend URL (optional in local dev if proxy is used)
VITE_API_URL=http://localhost:5000/api

# Option A: Formspree (Free - register at https://formspree.io and paste your Form ID)
# e.g. If your endpoint is https://formspree.io/f/xyzabkld, set:
VITE_FORMSPREE_ID=

# Option B: Web3Forms (Free - get instant Access Key at https://web3forms.com)
VITE_WEB3FORMS_KEY=

